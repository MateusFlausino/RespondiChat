# Copie para .env.local. Na Vercel, configure em Settings > Environment Variables.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_USERNAME=admin
# Gere com: pnpm password (a senha é solicitada sem aparecer na tela).
ADMIN_PASSWORD_HASH=
# Acesso próprio da Michelle em /michelle/login, usuário fixo: michelle.
MICHELLE_PASSWORD_HASH=
# Acesso próprio do Mateus em /mateus/login, usuário fixo: mateus.
MATEUS_PASSWORD_HASH=
# Gere cada segredo separadamente: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Use o Instagram App ID/Secret exibido em Instagram > API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# App Secret do aplicativo Meta que assina os webhooks (pode diferir do Instagram App Secret).
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# Os perfis permitidos são definidos por login: michelle/admin -> michellefmkt; mateus -> mf.luminarias3d.
# URL pública da página com identificação/contato de quem opera o painel.
PRIVACY_CONTACT=
# Somente em desenvolvimento local; nunca habilita envio real.
DEMO_MODE=false
